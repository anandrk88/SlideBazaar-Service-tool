{
  "name": "slidebazaar-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "refunds:settle": "tsx --conditions=react-server scripts/settle-refunds.ts",
    "verify:money": "tsx --conditions=react-server scripts/verify-money.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "storage:check": "tsx --conditions=react-server scripts/check-storage.ts",
    "wizard:purge": "tsx --conditions=react-server scripts/purge-wizard-attempts.ts",
    "bootstrap": "tsx --conditions=react-server scripts/bootstrap-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/client": "^6.19.3",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "next": "15.5.25",
    "nodemailer": "^10.0.1",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
