# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"
# Used to sign login cookies. Any long random string (32+ chars).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Set to "yes" on a deployed environment that is NOT open to real customers.
# Lets the app boot without live Stripe keys, SMTP or object storage. Never set
# it on the deployment customers use. See docs/PRODUCTION.md.
STAGING=""

# Public URL of this app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe (optional in development). Leave STRIPE_SECRET_KEY empty to use the
# built-in mock payment page, which simulates a successful charge.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Google sign-on (optional) ----
# Create a Web application client at https://console.cloud.google.com/auth/clients
# Authorized redirect URIs, byte-exact:
#   http://localhost:3000/api/auth/google/callback
#   https://design.slidebazaar.com/api/auth/google/callback
# Scopes: openid, email, profile. Leave both blank and the button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where uploaded files are stored on disk (relative to project root or absolute)
UPLOAD_DIR="./uploads"


# Email notifications (optional). Without SMTP_HOST, emails are written to uploads/outbox.log instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SlideBazaar Design Services <no-reply@slidebazaar.com>"

# ---- Object storage: Cloudflare R2 (required in production) ----
# Without S3_BUCKET, uploads go to UPLOAD_DIR on local disk, which Vercel wipes
# on every deploy. R2 is the chosen store; the driver is S3-compatible so AWS S3,
# Backblaze B2 and MinIO also work.
#
# In the Cloudflare dashboard: R2 > create a bucket, then
# "Manage API tokens" > create a token with Object Read & Write scoped to it.
# Verify with:  npm run storage:check
S3_BUCKET=""
S3_REGION="auto"
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
# Account id only. No bucket name, no trailing slash.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Bootstrapping the first admin (see npm run admin:create) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="SlideBazaar Admin"

# ---- Pabbly Connect webhook (optional) ----
# One webhook URL from a Pabbly Connect "Webhook" trigger. SlideBazaar POSTs a
# JSON event to it when somebody starts or gives up on the order form, when an
# order is placed, and for staff notifications. Pabbly turns those into email or
# WhatsApp. Leave it blank and nothing is sent and nothing breaks.
#
# TREAT THIS URL AS A PASSWORD. It is the only authentication there is: anyone
# holding it can post a fake "Order SB-9999 placed, $4,000" into your workflow
# and on to your phone. Never paste it into a ticket, an issue or a chat.
PABBLY_WEBHOOK_URL=

# Optional shared secret, sent as the x-slidebazaar-token header. Add a Pabbly
# Filter step "token equals ..." so that a leaked URL alone is not enough.
PABBLY_WEBHOOK_TOKEN=

# REQUIRED for timely "somebody gave up" alerts. Any 24+ character random string.
# Point a second Pabbly workflow at it: a Schedule trigger every 15 minutes doing
#   GET https://<your-app>/api/pabbly-sweep   with header x-sweep-token: <this>
# Nothing tells this app that a person closed a tab, so without the schedule an
# abandonment is only noticed when the next visitor happens to load a page, which
# on a quiet night means the morning, or never. Unset, that endpoint 404s.
PABBLY_SWEEP_TOKEN=
